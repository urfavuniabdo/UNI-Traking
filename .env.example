# ===== DB (تطوير: sqlite / إنتاج: postgresql) =====
# sqlite
DATABASE_URL="file:../../../_data/traccer.db"
# postgres (إنتاج) — فعّل هذا وعطّل اللي فوق، ثم npm run prisma:prod
# DATABASE_URL="postgresql://traccer:traccer@localhost:5432/traccer?schema=public"

PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# ===== Auth =====
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_INIT_PASSWORD=ChangeMe123!

# ===== Rules defaults (docs/CONTRACT.md §6) =====
DEFAULT_MAX_SPEED_KMH=80
STOP_ALERT_MIN=30
GEOFENCE_GRACE_S=120
ALERT_COOLDOWN_S=180
HEARTBEAT_INTERVAL_S=300
SHIFT_GRACE_MIN=30
REPLAY_MAX_AGE_HOURS=72

# ===== Sync =====
SYNC_CRON=0 */15 * * * *
SYNC_WEBHOOK_SECRET=change-me-sync

# ===== Push (FCM service account JSON as a single line) =====
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
PUSH_RETRY_MAX=3

# ===== WhatsApp Cloud API (اختياري) =====
WACLOUD_TOKEN=
WACLOUD_PHONE_NUMBER_ID=
WACLOUD_ALLOWED_TO=false

DASHBOARD_TIMEZONE=Africa/Cairo
