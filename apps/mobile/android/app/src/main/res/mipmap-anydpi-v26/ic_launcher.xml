<?xml version="1.0" encoding="utf-8"?>
<!-- The layer drawables MUST be android:drawable attributes: written as element text AAPT2
     never sees the reference, prunes mipmap/ic_launcher_foreground from the APK, and every
     launcher falls back to the stock green robot. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
